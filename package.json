{
  "name": "zyntrip-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:backend": "cd apps/api && npm run start:dev",
    "dev:legacy-backend": "cd backend && npm run start:dev",
    "dev:admin:workspace": "pnpm --filter @zyntrip/admin dev",
    "dev:mobile:workspace": "pnpm --filter @zyntrip/mobile start",
    "dev:rider:workspace": "pnpm --filter @zyntrip/rider-app start",
    "dev:driver:workspace": "pnpm --filter @zyntrip/driver-app start",
    "dev:api:workspace": "pnpm --filter @zyntrip/api start:dev",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "cd apps/api && npm run build",
    "build:legacy-backend": "cd backend && npm run build",
    "build:workspaces": "pnpm turbo run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "6.3.5"
  }
}
